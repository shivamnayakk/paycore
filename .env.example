# Application Settings
PROJECT_NAME="PayCore"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# Database
# Defaults to async SQLite for local development (no external setup needed)
# In production / Docker, change to: postgresql+asyncpg://postgres:postgres@localhost:5432/paycore
DATABASE_URL="sqlite+aiosqlite:///./paycore.db"

# Security
SECRET_KEY="super-secret-key-change-in-production"
ALLOWED_ORIGINS=["*"]

# Mock Gateway Settings
MOCK_GATEWAY_SUCCESS_RATE=0.90
MOCK_GATEWAY_LATENCY_MS=200
